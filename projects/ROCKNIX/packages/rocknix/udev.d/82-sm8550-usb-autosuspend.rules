# The primary SM8550 DWC3 controller otherwise stays runtime-active and holds
# its 1 GB/s USB-to-DDR interconnect vote while idle, which the RPMh sleep set
# then carries through suspend. Runtime PM honours attached-device activity, so
# only an idle controller is autosuspended.
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="a600000.usb", ATTR{power/control}="auto"
